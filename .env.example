# OneTap Configuration
# Copy this file to .env and adjust values

# Server port (default: 3000)
PORT=3000

# Admin credentials (CHANGE THESE IN PRODUCTION!)
# Default: admin / admin123 (will show startup warning)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Optional: Pre-hashed admin password (use instead of ADMIN_PASSWORD)
# Generate with: node -e "const crypto=require('crypto'); const salt=crypto.randomBytes(16); const hash=crypto.scryptSync('your-password', salt, 32, {N:16384,r:8,p:1}); console.log('scrypt:'+salt.toString('base64')+':'+hash.toString('base64'))"
# ADMIN_PASSWORD_HASH=scrypt:...

# Vercel deployment URL (auto-detected if deployed on Vercel)
# VERCEL_URL=your-app.vercel.app